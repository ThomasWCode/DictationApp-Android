<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- adb-only test hooks (the counterparts of the Windows simulate and stream-test switches). The DUMP
             permission is held by the adb shell but can never be granted to an installed app. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.thomaswcode.dictationapp.debug.SET_KEYS" />
                <action android:name="com.thomaswcode.dictationapp.debug.SIMULATE" />
                <action android:name="com.thomaswcode.dictationapp.debug.STREAM_TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
